# ─────────────────────────────────────────────────────────────
# Hisab Ki Kitab — frontend environment variables
# Copy to `.env` (Vite only exposes variables prefixed with VITE_).
# ─────────────────────────────────────────────────────────────

# Where the backend lives. Leave it as /api.
# Locally, vite.config.js proxies /api to http://localhost:5000; in the
# recommended deployment vercel.json routes /api to the backend service. Either
# way the SPA and the API share one origin, which is what lets the refresh
# cookie stay SameSite=Lax.
# Only a split deployment (API on its own domain) needs an absolute URL here,
# and that also requires COOKIE_SAMESITE=none on the API - a weaker setting.
VITE_API_URL=/api

VITE_APP_NAME=Hisab Ki Kitab

# Google Analytics 4 (optional). Use a Web data stream Measurement ID.
# Analytics is enabled automatically only in production builds. To deliberately
# test it from a local development build, also set VITE_GA_ENABLE_LOCAL=true.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_GA_ENABLE_LOCAL=false
