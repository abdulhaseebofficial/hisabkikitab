# ─────────────────────────────────────────────────────────────
# Hisab Ki Kitab — backend environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
# IMPORTANT: anything other than "development" or "test" is treated as
# production. Leaving this unset is SAFE - it defaults to production behaviour
# (no stack traces, secure cookies, strict secret checks).
NODE_ENV=development

# Number of reverse proxies in front of the app. Only set this if there IS one:
# trusting X-Forwarded-For without a proxy lets clients spoof their IP and skip
# the per-IP rate limit. Defaults to 1 in production, none in development.
# TRUST_PROXY=1

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# How cross-site the refresh cookie may be: lax (default), strict, or none.
# Leave it unset. The recommended deployment serves the SPA and this API from
# one origin, where lax works and withholds the cookie from cross-site POSTs.
# Set it to none ONLY for a split deployment (SPA and API on different sites);
# it requires HTTPS, and it is the weaker setting against CSRF.
# COOKIE_SAMESITE=lax

# Google sign-in (optional). Leave unset and the button never appears.
# Create an OAuth 2.0 Client ID of type "Web application" at
# https://console.cloud.google.com/apis/credentials and add your site to
# "Authorised JavaScript origins" - your deployment URL, and
# http://localhost:5173 for local work.
# Only the client id is needed. There is no client secret in this flow, so
# there is no secret here to leak. The API serves this value to the sign-in
# screen, so it is the single place to configure it.
# Leave it unset and the button is simply never shown. Set it to something that
# is NOT a Web client id and the API refuses to start: a value that is present
# but wrong means somebody meant to enable this, and the failure would otherwise
# wait until a real person clicked the button.
# GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Where rate-limit counters are kept.
#
#   unset / auto  Postgres in production, in memory everywhere else. The right
#                 answer for this deployment, and what you want by default.
#   postgres      the shared counter, in the rate_limits table. No extra
#                 service and no extra credential - the app already requires
#                 Postgres.
#   memory        per process. Correct for one long-lived server; on anything
#                 that runs several instances the limit appears in the response
#                 headers and stops nobody. Warned about at startup in
#                 production.
#
# RATE_LIMIT_STORE=postgres

# Optional. Salts the hash used for rate-limit keys, so the stored counters
# cannot be matched back to an IP address or an account even with the table in
# hand. Any long random string; changing it just resets every counter.
# RATE_LIMIT_SALT=change-me-to-anything-long-and-random

# Postgres connection string. This is the ONLY database variable the app needs.
#
# POSTGRES_URL is accepted under that name too, because the Vercel Supabase and
# Neon integrations each write their own - so provisioning either from the
# marketplace needs nothing here at all.
#
# To develop against the deployed database:
#   vercel env pull .env.production.local --environment=production
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: a direct (non-pooled) connection, used ONLY by the migration
# runner. Supabase's pooler runs in transaction mode, which is right for
# queries and wrong for DDL - a migration wants one session that holds its
# advisory lock for the whole transaction. Supabase publishes this as
# POSTGRES_URL_NON_POOLING, which is also accepted. Unset is fine: Neon and a
# local Postgres already hand out real sessions.
# DIRECT_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── What this app does NOT need ──────────────────────────────────────
# If you provisioned Supabase from the Vercel marketplace it will have set
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_JWT_SECRET
# and a set of NEXT_PUBLIC_* copies. This app uses NONE of them, and there is no
# Supabase client anywhere in the tree.
#
# Supabase is used purely as hosted Postgres, reached over the ordinary wire
# protocol with `pg`. Authentication is this app's own (JWT + rotating refresh
# cookie), so Supabase Auth, RLS, Realtime and Storage are all unused. The
# NEXT_PUBLIC_* names are a Next.js convention and mean nothing to Vite.
#
# Leaving those variables set in the hosting environment is harmless. Do not
# add them here, and do not read them from code: an anon key in this app would
# be a second, weaker way into the same data.

# JWT — use long random strings (e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# The AI advisor. Set ONE of the two keys below and the advisor turns on;
# set neither and the app still works, answering from built-in rule based
# advice instead. Gemini is checked first when both are present.

# Google Gemini — free tier, get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude — paid, get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Preferred model, optional. Leave it empty to use the sensible default for
# whichever key is set (gemini-2.5-flash / claude-opus-5). If your key cannot
# reach the model named here the backend walks its own fallback list and only
# then gives up to the built-in advisor, so any key works without editing this.
AI_MODEL=

# Local development only. When SMTP is not configured this returns the raw
# password-reset token in the API response so the flow can be tested. It is an
# account-takeover primitive - never enable it anywhere real.
ALLOW_DEV_RESET_LINK=false

# Optional: password reset e-mail (SMTP). If unset, delivery is reported unavailable;
# message bodies and reset tokens are never logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Hisab Ki Kitab <no-reply@hisabkikitab.app>
