{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/internal/recurring",
      "schedule": "5 0 * * *"
    }
  ],
  "services": {
    "frontend": {
      "root": "apps/web",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/",
          "destination": "/index.html"
        },
        {
          "source": "/tools/:tool",
          "destination": "/tools/:tool/index.html"
        },
        {
          "source": "/tools",
          "destination": "/tools/index.html"
        },
        {
          "source": "/learn/:category/:slug",
          "destination": "/learn/:category/:slug/index.html"
        },
        {
          "source": "/learn/:category",
          "destination": "/learn/:category/index.html"
        },
        {
          "source": "/learn",
          "destination": "/learn/index.html"
        },
        {
          "source": "/about",
          "destination": "/about/index.html"
        },
        {
          "source": "/contact",
          "destination": "/contact/index.html"
        },
        {
          "source": "/privacy",
          "destination": "/privacy/index.html"
        },
        {
          "source": "/terms",
          "destination": "/terms/index.html"
        },
        {
          "source": "/disclaimer",
          "destination": "/disclaimer/index.html"
        },
        {
          "source": "/(.*)",
          "destination": "/app.html"
        }
      ]
    },
    "backend": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
