{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/internal/recurring",
      "schedule": "5 0 * * *"
    }
  ],
  "services": {
    "frontend": {
      "root": "apps/web",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/",
          "destination": "/index.html"
        },
        {
          "source": "/tools/:tool/",
          "destination": "/tools/:tool/index.html"
        },
        {
          "source": "/tools/",
          "destination": "/tools/index.html"
        },
        {
          "source": "/learn/:category/:slug/",
          "destination": "/learn/:category/:slug/index.html"
        },
        {
          "source": "/learn/:category/",
          "destination": "/learn/:category/index.html"
        },
        {
          "source": "/learn/",
          "destination": "/learn/index.html"
        },
        {
          "source": "/about/",
          "destination": "/about/index.html"
        },
        {
          "source": "/contact/",
          "destination": "/contact/index.html"
        },
        {
          "source": "/privacy/",
          "destination": "/privacy/index.html"
        },
        {
          "source": "/terms/",
          "destination": "/terms/index.html"
        },
        {
          "source": "/disclaimer/",
          "destination": "/disclaimer/index.html"
        },
        {
          "source": "/reset-password/:token",
          "destination": "/app.html"
        },
        {
          "source": "/(login|register|forgot-password)/",
          "destination": "/app.html"
        },
        {
          "source": "/(login|register|forgot-password|onboarding|dashboard|expenses|income|goals|debts|budget|advisor|reports|settings|business)",
          "destination": "/app.html"
        },
        {
          "source": "/business/(.*)",
          "destination": "/app.html"
        }
      ]
    },
    "backend": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "redirects": [
    {
      "source": "/learn",
      "destination": "/learn/",
      "statusCode": 301
    },
    {
      "source": "/learn/:category([a-z0-9-]+)",
      "destination": "/learn/:category/",
      "statusCode": 301
    },
    {
      "source": "/learn/:category([a-z0-9-]+)/:slug([a-z0-9-]+)",
      "destination": "/learn/:category/:slug/",
      "statusCode": 301
    },
    {
      "source": "/tools",
      "destination": "/tools/",
      "statusCode": 301
    },
    {
      "source": "/tools/:tool([a-z0-9-]+)",
      "destination": "/tools/:tool/",
      "statusCode": 301
    },
    {
      "source": "/about",
      "destination": "/about/",
      "statusCode": 301
    },
    {
      "source": "/contact",
      "destination": "/contact/",
      "statusCode": 301
    },
    {
      "source": "/privacy",
      "destination": "/privacy/",
      "statusCode": 301
    },
    {
      "source": "/terms",
      "destination": "/terms/",
      "statusCode": 301
    },
    {
      "source": "/disclaimer",
      "destination": "/disclaimer/",
      "statusCode": 301
    },
    {
      "source": "/login",
      "destination": "/login/",
      "statusCode": 301
    },
    {
      "source": "/register",
      "destination": "/register/",
      "statusCode": 301
    },
    {
      "source": "/forgot-password",
      "destination": "/forgot-password/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
